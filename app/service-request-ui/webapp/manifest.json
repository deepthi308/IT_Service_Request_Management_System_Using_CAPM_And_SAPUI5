{
  "_version": "1.89.0",
  "sap.app": {
    "id": "com.mandeep.servicerequestui",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.32.0",
      "toolsId": "f35e2b61-a00c-4c24-bc68-fb71af1f9919"
    },
    "dataSources": {
      "mainService": {
        "uri": "/service-requests/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "ZServiceRequestManagement-manage": {
          "semanticObject": "ZServiceRequestManagement",
          "action": "manage",
          "title": "{{ZServiceRequestManagement-manage.flpTitle}}",
          "subTitle": "{{ZServiceRequestManagement-manage.flpSubtitle}}",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.152.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.mandeep.servicerequestui.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "com.mandeep.servicerequestui.view",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "dashboard",
          "target": "dashboard"
        },
        {
          "pattern": "requests",
          "name": "requests",
          "target": "requests"
        },
        {
          "pattern": "requests/{requestId}",
          "name": "requestDetails",
          "target": "requestDetails"
        },
        {
          "pattern": "create-request",
          "name": "createRequest",
          "target": "createRequest"
        }
      ],
      "targets": {
        "dashboard": {
          "viewName": "Dashboard",
          "viewId": "dashboard"
        },
        "requests": {
          "viewName": "Requests",
          "viewId": "requests"
        },
        "requestDetails": {
          "viewName": "RequestDetails",
          "viewId": "requestDetails"
        },
        "createRequest": {
          "viewName": "CreateRequest",
          "viewId": "createRequest"
        }
      }
    },
    "rootView": {
      "viewName": "com.mandeep.servicerequestui.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}